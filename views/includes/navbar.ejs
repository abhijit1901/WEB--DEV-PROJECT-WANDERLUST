  <script>
    // Search functionality   
                 document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const searchBtn = document.querySelector('.search-btn');
            const listings = document.querySelectorAll('.flip-card');
            
            let debounceTimer;
        
            function filterBySearch(searchTerm) {
                let hasResults = false;
        
                listings.forEach(listing => {
                    const title = listing.querySelector('.title-in-box')?.textContent.toLowerCase() || '';
                    const categories = listing.dataset.categories?.toLowerCase() || '';
                    
                    if (title.includes(searchTerm) || categories.includes(searchTerm)) {
                        listing.classList.remove('hidden');
                        listing.style.animation = 'fadeIn 0.5s ease-in forwards';
                        hasResults = true;
                    } else {
                        listing.classList.add('hidden');
                    }
                });
        
                return hasResults;
            }
        
            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    const searchTerm = this.value.toLowerCase().trim();
                    
                    // Clear active filters when searching
                    document.querySelectorAll('.filter.active').forEach(filter => {
                        filter.classList.remove('active');
                    });
                    
                    if (searchTerm.length >= 2) {
                        filterBySearch(searchTerm);
                    } else {
                        // Show all listings if search term is too short
                        listings.forEach(listing => {
                            listing.classList.remove('hidden');
                            listing.style.animation = 'fadeIn 0.5s ease-in forwards';
                        });
                    }
                }, 300);
            });
        
            // Clear search on escape key
            searchInput.addEventListener('keyup', function(e) {
                if (e.key === 'Escape') {
                    this.value = '';
                    listings.forEach(listing => {
                        listing.classList.remove('hidden');
                        listing.style.animation = 'fadeIn 0.5s ease-in forwards';
                    });
                }
            });
        });
  </script>