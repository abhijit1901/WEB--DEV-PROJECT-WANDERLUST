<style>
  .search-container {
    position: relative;
    width: 350px;
}

.search-box {
    position: relative;
    display: flex;
    align-items: center;
}

.search-input {
    width: 100%;
    padding: 10px 40px 10px 15px;
    border: 2px solid #ff000033;
    border-radius: 25px;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    background: white;
}

.search-input:focus {
    outline: none;
    border-color: #ff0000;
    box-shadow: 0 0 10px rgba(255, 0, 0, 0.1);
    width: calc(100% + 50px);
}

.search-btn {
    position: absolute;
    right: 5px;
    background: none;
    border: none;
    color: #ff0000;
    padding: 8px 12px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.search-btn:hover {
    color: #cc0000!important;
}

.search-suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    border-radius: 10px;
    margin-top: 5px;
    box-shadow: 0 4px 15px rgba(255, 0, 0, 0.1);
    display: none;
    z-index: 1000;
    max-height: 300px;
    overflow-y: auto;
}

.suggestion-item {
    padding: 10px 15px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.suggestion-item:hover {
    background: rgba(255, 0, 0, 0.05);
}

@media (max-width: 768px) {
    .search-container {
        width: 100%;
        margin: 10px 0;
    }
}
/* Add these new styles */
.no-results {
    padding: 20px;
    text-align: center;
    color: #666;
}

.no-results i {
    font-size: 1.5rem;
    margin-bottom: 10px;
}

.no-results p {
    margin: 0;
}

.search-input::placeholder {
    color: #999;
    font-style: italic;
}
/* Add inside your existing <style> tag */

.branding {
    position: relative;
    padding: 10px;
    transition: all 0.3s ease;
}

.branding::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 0;
    height: 0;
    background: radial-gradient(circle, rgba(255, 0, 0, 0.1) 0%, rgba(255, 0, 0, 0) 70%);
    border-radius: 50%;
    transition: all 0.5s ease;
    z-index: -1;
}

.branding:hover::before {
    width: 150px;
    height: 150px;
    animation: pulse 2s infinite;
}

.branding .navbar-brand {
    position: relative;
    z-index: 1;
}

.branding:hover .fa-compass {
    animation: spin 2s infinite linear;
}

@keyframes pulse {
    0% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.9;
    }
    50% {
        transform: translate(-50%, -50%) scale(1.2);
        opacity: 0.6;
    }
    100% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.8;
    }
}

@keyframes spin {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}

@keyframes fadeIn {
    from { 
        opacity: 0; 
        transform: translateY(-10px); 
    }
    to { 
        opacity: 1; 
        transform: translateY(0); 
    }
}
/* Update the base container styles */
.container-fluid {
    padding: 0 15px;
    background-color: white;
}

/* Update media queries for responsiveness */
@media (max-width: 768px) {
    .search-container {
        width: 100%!important;
        margin: 10px 0;
        order: 1;
    }

    .navbar-nav {
        flex-direction: column!important;
        width: 100%!important;
        gap: 10px!important;
    }

    .navbar-collapse {
        flex-direction: column;
        align-items: stretch;
    }

    .auth-btn {
        width: 100% !important;
        max-width: 200px;
        margin: 5px auto;
    }

    .auth-text {
        opacity: 1;
        width: auto;
    }

    .branding {
        margin-right: auto;
    }

    .navbar-toggler {
        margin-left: 10px;
    }
}
@media (max-width: 773px) {
    .navbar-nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        width: 100%;
    }

    .auth-btn {
        display: flex;
        justify-content: center;
        width: 200px !important;
        padding: 30px 51px;
    }

    .auth-text {
        opacity: 1;
        width: auto;
        position: static;
    }
    .navbar {
        background-color: white !important;
    }
    .auth-sign {
        margin-right: 8px;
    }

    .navbar-collapse {
        padding: 1rem 0;
        text-align: center;
        background-color: white;
    }

    .search-container {
        order: -1;
        width: 100%;
        margin: 10px 0;
    }

    .search-input:focus {
        width: 100%;
    }

    .ms-auto {
        margin: 0 auto !important;
    }
}
@media (max-width: 576px) {
    .container-fluid {
        padding: 0 10px;
    }

    .navbar-brand p {
        font-size: 1.1rem;
    }

    .auth-btn {
        width: 100% !important;
        max-width: 180px;
    }

    .search-input {
        font-size: 0.9rem;
    }

    .search-input:focus {
        width: 100%;
    }
}

@media (max-width: 360px) {
    .navbar-brand p {
        font-size: 1rem;
    }

    .auth-btn {
        width: 100% !important;
        max-width: 160px;
        padding: 8px;
        margin: 3px auto;
    }

    .search-container {
        margin: 8px 0;
    }
}
</style>

