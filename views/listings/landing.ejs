<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust | Your Travel Adventure Begins</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #ffffff;
            font-family: 'Poppins', sans-serif;
            overflow: hidden;
            color: #333;
        }

        .container {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            background: radial-gradient(circle at center, rgba(255,255,255,1) 0%, rgba(255,245,245,1) 100%);
        }

        .background-pattern {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(45deg, #ff000008 25%, transparent 25%),
                linear-gradient(-45deg, #ff000008 25%, transparent 25%),
                linear-gradient(45deg, transparent 75%, #ff000008 75%),
                linear-gradient(-45deg, transparent 75%, #ff000008 75%);
            background-size: 20px 20px;
            animation: patternMove 15s linear infinite;
        }

        .content-wrapper {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 800px;
            padding: 2rem;
        }

        .logo {
            font-size: 5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #ff0000 0%, #ff4444 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1.5rem;
            animation: fadeInDown 1s ease-out;
        }

        .tagline {
            font-size: 1.8rem;
            color: #666;
            margin-bottom: 3rem;
            font-weight: 300;
            animation: fadeIn 1s ease-out 0.5s both;
        }

        .explore-btn {
            padding: 1.2rem 3rem;
            font-size: 1.2rem;
            color: #ffffff;
            background: linear-gradient(135deg, #ff0000 0%, #ff4444 100%);
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            letter-spacing: 1px;
        }

        .explore-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: 0.5s;
        }

        .explore-btn:hover::before {
            left: 100%;
        }

        .explore-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(255, 0, 0, 0.2);
        }

        .floating-icons {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .icon {
            position: absolute;
            font-size: 1.5rem;
            color: #ff0000;
            opacity: 0.15;
            filter: blur(0.5px);
            transition: all 0.3s ease;
        }

        @keyframes patternMove {
            from { background-position: 0 0; }
            to { background-position: 40px 40px; }
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .social-links {
            position: absolute;
            bottom: 2rem;
            display: flex;
            gap: 1.5rem;
            animation: fadeIn 1s ease-out 1s both;
        }

        .social-links a {
            color: #666;
            font-size: 1.5rem;
            transition: all 0.3s ease;
        }

        .social-links a:hover {
            color: #ff0000;
            transform: translateY(-3px);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="background-pattern"></div>
        <div class="floating-icons">
            <i class="fa-solid fa-plane icon" style="top: 15%; left: 15%"></i>
            <i class="fa-solid fa-mountain icon" style="top: 75%; left: 85%"></i>
            <i class="fa-solid fa-compass icon" style="top: 35%; left: 88%"></i>
            <i class="fa-solid fa-map-location-dot icon" style="top: 85%; left: 25%"></i>
            <i class="fa-solid fa-camera-retro icon" style="top: 25%; left: 75%"></i>
            <i class="fa-solid fa-earth-americas icon" style="top: 45%; left: 10%"></i>
            <i class="fa-solid fa-passport icon" style="top: 65%; left: 92%"></i>
            <i class="fa-solid fa-route icon" style="top: 12%; left: 88%"></i>
        </div>
        <div class="content-wrapper">
            <h1 class="logo">Wanderlust</h1>
            <p class="tagline">Discover. Experience. Remember.</p>
            <button class="explore-btn" onclick="window.location.href='/listings'">
                Start Your Journey <i class="fas fa-arrow-right" style="margin-left: 8px;"></i>
            </button>
        </div>
        <div class="social-links">
            <a href="https://www.instagram.com/abhijitjha__22?igsh=dzlvZGQwdWFyYmU4"><i class="fab fa-instagram"></i></a>
            <a href="https://github.com/abhijit1901"><i class="fab fa-github"></i></a>
            <a href="https://www.linkedin.com/in/abhijit-jha-95191526b?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app"><i class="fab fa-linkedin"></i></a>
        </div>
    </div>

    <script>
        // Enhanced icon animation
        document.querySelectorAll('.icon').forEach(icon => {
            const randomDuration = 5 + Math.random() * 5;
            const randomDelay = Math.random() * 2;
            const randomDistance = 10 + Math.random() * 20;
            
            icon.style.animation = `
                float ${randomDuration}s ease-in-out infinite,
                rotate ${randomDuration * 2}s ease-in-out infinite
            `;
            icon.style.animationDelay = `${randomDelay}s`;

            // Custom float animation for each icon
            const keyframes = `
                @keyframes float_${icon.id} {
                    0%, 100% { transform: translate(0, 0); }
                    50% { transform: translate(${randomDistance}px, ${-randomDistance}px); }
                }
            `;
            
            const styleSheet = document.createElement("style");
            styleSheet.textContent = keyframes;
            document.head.appendChild(styleSheet);
        });
    </script>
</body>
</html><!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to Wanderlust</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #ffffff;
            font-family: 'Arial', sans-serif;
            overflow: hidden;
        }

        .container {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, #ff0000 25%, #ffffff 25%, #ffffff 50%, #ff0000 50%, #ff0000 75%, #ffffff 75%);
            background-size: 100px 100px;
            animation: moveBackground 15s linear infinite;
            opacity: 0.1;
        }

        @keyframes moveBackground {
            0% { background-position: 0 0; }
            100% { background-position: 100px 100px; }
        }

        .content {
            text-align: center;
            z-index: 1;
            padding: 2rem;
        }

        .title {
            font-size: 5rem;
            color: #ff0000;
            margin-bottom: 1rem;
            animation: fadeInDown 1s ease-out;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        }

        .subtitle {
            font-size: 1.5rem;
            color: #666;
            margin-bottom: 2rem;
            animation: fadeIn 1s ease-out 0.5s both;
        }

        .explore-btn {
            padding: 1rem 2rem;
            font-size: 1.2rem;
            color: #ffffff;
            background-color: #ff0000;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: transform 0.3s, box-shadow 0.3s;
            animation: pulse 2s infinite;
        }

        .explore-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(255, 0, 0, 0.5);
        }

        .icons {
            position: absolute;
            width: 100%;
            height: 100%;
        }

        .icon {
            position: absolute;
            font-size: 2rem;
            color: #ff0000;
            opacity: 0.2;
            animation: float 6s infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(180deg); }
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="background"></div>
        <div class="icons">
            <i class="fa-solid fa-plane icon" style="top: 20%; left: 20%"></i>
            <i class="fa-solid fa-mountain icon" style="top: 70%; left: 80%"></i>
            <i class="fa-solid fa-compass icon" style="top: 40%; left: 90%"></i>
            <i class="fa-solid fa-map icon" style="top: 80%; left: 30%"></i>
            <i class="fa-solid fa-camera icon" style="top: 30%; left: 70%"></i>
        </div>
        <div class="content">
            <h1 class="title">Wanderlust</h1>
            <p class="subtitle">Your journey begins here</p>
            <button class="explore-btn" onclick="window.location.href='/listings'">
                Start Exploring <i class="fas fa-arrow-right"></i>
            </button>
        </div>
    </div>

    <script>
        // Add random movement to icons
        document.querySelectorAll('.icon').forEach(icon => {
            icon.style.animation = `float ${5 + Math.random() * 5}s infinite`;
            icon.style.animationDelay = `${Math.random() * 2}s`;
        });
    </script>
</body>
</html>