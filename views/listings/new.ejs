        // Rest of your existing JavaScript stays exactly the same
        async function fetchCountries() {
            try {
                const response = await fetch('https://restcountries.com/v3.1/all');
                const countries = await response.json();
                return countries
                    .map(country => country.name.common)
                    .sort();
            } catch (error) {
                console.error('Error fetching countries:', error);
                return [];
            }
        }
    
        async function fetchCities(country) {
            try {
                const response = await fetch(`https://countriesnow.space/api/v0.1/countries/cities`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ country })
                });
                const data = await response.json();
                return data.data.sort();
            } catch (error) {
                console.error('Error fetching cities:', error);
                return [];
            }
        }
    
        function filterOptions(searchInput, selectElement, options) {
            const searchTerm = searchInput.value.toLowerCase();
            selectElement.innerHTML = '<option value="">Select</option>';
            
            options
                .filter(option => option.toLowerCase().includes(searchTerm))
                .forEach(option => {
                    const optionElement = document.createElement('option');
                    optionElement.value = option;
                    optionElement.textContent = option;
                    selectElement.appendChild(optionElement);
                });
        }
    
        async function initializeDropdowns() {
            const countries = await fetchCountries();
            
            countrySearch.addEventListener('input', () => {
                filterOptions(countrySearch, countrySelect, countries);
            });
    
            countrySelect.addEventListener('change', async () => {
                const selectedCountry = countrySelect.value;
                if (selectedCountry) {
                    locationSelect.innerHTML = '<option value="">Loading locations...</option>';
                    const cities = await fetchCities(selectedCountry);
                    locationSelect.innerHTML = '<option value="">Select Location</option>';
                    cities.forEach(city => {
                        const option = document.createElement('option');
                        option.value = city;
                        option.textContent = city;
                        locationSelect.appendChild(option);
                    });
                }
            });
    
            locationSearch.addEventListener('input', () => {
                const cities = Array.from(locationSelect.options)
                    .map(option => option.value)
                    .filter(value => value !== '');
                filterOptions(locationSearch, locationSelect, cities);
            });
    
            filterOptions(countrySearch, countrySelect, countries);
        }
        document.addEventListener('DOMContentLoaded', initializeDropdowns);
            // Initialize the map
            var map = L.map('map').setView([51.505, -0.09], 13);

        // Add a tile layer to the map (OpenStreetMap)
