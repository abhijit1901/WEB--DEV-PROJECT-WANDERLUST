        }).addTo(map);

        // Add a marker to the map
        var marker = L.marker([51.505, -0.09]).addTo(map)
            .bindPopup('Your Location')
            .openPopup();

        // Update map based on location and country fields
        document.getElementById('location').addEventListener('change', updateMap);
        document.getElementById('country').addEventListener('change', updateMap);

        function updateMap() {
            var location = document.getElementById('location').value;
            var country = document.getElementById('country').value;
            if (location && country) {
                fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${location},${country}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.length > 0) {
                            var lat = data[0].lat;
                            var lon = data[0].lon;
                            map.setView([lat, lon], 13);
                            marker.setLatLng([lat, lon]);
                            marker.bindPopup(`${location}, ${country}`).openPopup();
                        }
                    });
            }
        }
    </script>
</body>
